../temp4/scara_panel.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile ../temp4/scara_panel.pro -spec linux-oe-g++ CONFIG+=debug CONFIG+=qml_debug

qmake_all: FORCE


all: Makefile scara_panel

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /opt/sdk-loongson/LoongOS/v0.1/sysroots/loongarch64-Loongson-linux/usr/lib64/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents ../temp4/mainwindow.h ../temp4/i2c_worker.h ../temp4/sensor_sim.h ../temp4/i2c_driver.h ../temp4/kinematics.h ../temp4/camera.h $(DISTDIR)/
	$(COPY_FILE) --parents ../temp4/main.cpp ../temp4/mainwindow.cpp ../temp4/i2c_worker.cpp ../temp4/sensor_sim.c ../temp4/i2c_driver.c ../temp4/camera.cpp $(DISTDIR)/
	$(COPY_FILE) --parents ../temp4/mainwindow.ui $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) $(TARGET) 
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile



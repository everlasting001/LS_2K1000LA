####### Compile

main.o: ../temp4/main.cpp ../temp4/mainwindow.h \
		../temp4/i2c_worker.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../temp4/main.cpp

mainwindow.o: ../temp4/mainwindow.cpp ../temp4/mainwindow.h \
		../temp4/i2c_worker.h \
		ui_mainwindow.h \
		../temp4/camera.h \
		../temp4/kinematics.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o ../temp4/mainwindow.cpp

i2c_worker.o: ../temp4/i2c_worker.cpp ../temp4/i2c_worker.h \
		../temp4/sensor_sim.h \
		../temp4/i2c_driver.h \
		../temp4/kinematics.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o i2c_worker.o ../temp4/i2c_worker.cpp

sensor_sim.o: ../temp4/sensor_sim.c ../temp4/sensor_sim.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o sensor_sim.o ../temp4/sensor_sim.c

i2c_driver.o: ../temp4/i2c_driver.c ../temp4/i2c_driver.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o i2c_driver.o ../temp4/i2c_driver.c

camera.o: ../temp4/camera.cpp ../temp4/camera.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o camera.o ../temp4/camera.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp


	loongarch64-Loongson-linux-g++ -march=loongarch64 -mabi=lp64 -fstack-protector-strong -O2 -D_FORTIFY_SOURCE=2 -Wformat -Wformat-security -Werror=format-security --no-sysroot-suffix -pipe --sysroot=/opt/sdk-loongson/LoongOS/v0.1/sysroots/loongarch64-Loongson-linux -g -Wall -Wextra -dM -E -o moc_predefs.h /opt/sdk-loongson/LoongOS/v0.1/sysroots/loongarch64-Loongson-linux/usr/lib64/mkspecs/features/data/dummy.cpp

